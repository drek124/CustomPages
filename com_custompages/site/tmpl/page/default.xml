<?xml version="1.0" encoding="utf-8"?>
<metadata>
    <layout title="COM_CUSTOMPAGES_VIEW_PAGE_TITLE">
        <message>COM_CUSTOMPAGES_VIEW_PAGE_DESC</message>
    </layout>
    <fields name="request">
        <fieldset name="request" addfieldprefix="Joomla\Component\Custompages\Administrator\Field">
            <field
                name="id"
                type="modal_page"
                label="COM_CUSTOMPAGES_SELECT_PAGE"
                select="true"
                clear="true"
                required="true"
                filter="integer"
            />
        </fieldset>
    </fields>
    <fields name="params">
        <fieldset
            name="custompages_template"
            label="COM_CUSTOMPAGES_FIELDSET_TEMPLATE_LABEL"
            addfieldprefix="Joomla\Component\Custompages\Administrator\Field"
            addruleprefix="Joomla\Component\Custompages\Administrator\Rule"
        >
            <field
                name="template_style"
                type="templatestyle"
                client="site"
                label="COM_CUSTOMPAGES_FIELD_TEMPLATE_STYLE_LABEL"
                description="COM_CUSTOMPAGES_FIELD_TEMPLATE_STYLE_DESC"
                default="none"
                filter="cmd"
            >
                <option value="none">COM_CUSTOMPAGES_TEMPLATE_STYLE_NONE</option>
                <option value="0">COM_CUSTOMPAGES_TEMPLATE_STYLE_DEFAULT</option>
            </field>
            <field
                name="template_position"
                type="templateposition"
                label="COM_CUSTOMPAGES_FIELD_TEMPLATE_POSITION_LABEL"
                description="COM_CUSTOMPAGES_FIELD_TEMPLATE_POSITION_DESC"
                showon="template_style!:none"
                validate="templateposition"
                message="COM_CUSTOMPAGES_FIELD_TEMPLATE_POSITION_REQUIRED"
                filter="cmd"
            >
                <option value="">COM_CUSTOMPAGES_TEMPLATE_POSITION_SELECT</option>
            </field>
        </fieldset>
        <fieldset name="custompages_http" label="COM_CUSTOMPAGES_FIELDSET_HTTP_LABEL">
            <field
                name="cache_control"
                type="text"
                label="COM_CUSTOMPAGES_FIELD_CACHE_CONTROL_LABEL"
                description="COM_CUSTOMPAGES_FIELD_CACHE_CONTROL_DESC"
                hint="public, max-age=300"
                filter="string"
            />
        </fieldset>
    </fields>
</metadata>
