<?xml version="1.0" encoding="utf-8"?>
<metadata>
    <layout title="COM_CUSTOMPAGES_VIEW_PAGE_TITLE">
        <message>COM_CUSTOMPAGES_VIEW_PAGE_DESC</message>
    </layout>
    <fields name="request">
        <fieldset name="request">
            <field
                name="id"
                type="sql"
                label="COM_CUSTOMPAGES_SELECT_PAGE"
                query="SELECT id AS value, title AS text FROM #__custompages_pages WHERE state = 1 ORDER BY title"
                key_field="value"
                value_field="text"
                required="true"
            />
        </fieldset>
    </fields>
    <fields name="params">
        <fieldset name="custompages_http" label="COM_CUSTOMPAGES_FIELDSET_HTTP_LABEL">
            <field
                name="cache_control"
                type="text"
                label="COM_CUSTOMPAGES_FIELD_CACHE_CONTROL_LABEL"
                description="COM_CUSTOMPAGES_FIELD_CACHE_CONTROL_DESC"
                hint="public, max-age=300"
                filter="string"
            />
        </fieldset>
    </fields>
</metadata>
